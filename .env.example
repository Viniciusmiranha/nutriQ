PORT=3000
URL_PUBLICA=http://localhost:3000
NUTRIQ_MODO_SEM_BANCO=false
NUTRIQ_MODO_DEMO=false

# Banco de dados MySQL.
# Deixe MYSQL_HOST vazio para o NUTRIQ iniciar sozinho um MySQL local (pasta servidor/dados/mysql),
# usando o MySQL Server instalado no computador.
# Para usar o MySQL da equipe (ou XAMPP/WAMP), preencha os dados abaixo:
# MYSQL_HOST=localhost
# MYSQL_PORTA=3306
# MYSQL_USUARIO=root
# MYSQL_SENHA=sua-senha
MYSQL_HOST=
MYSQL_PORTA=3306
MYSQL_USUARIO=root
MYSQL_SENHA=
MYSQL_BANCO=nutriq
MYSQL_PORTA_LOCAL=3307
MYSQLD_CAMINHO=

# Envio de e-mails (relatórios, avaliações, planos, lembretes e recuperação de senha).
# Sem estes dados as mensagens ficam salvas em servidor/emails para conferência.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORTA=465, SMTP_SEGURO=true
# e uma senha de app criada em https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=NUTRIQ <seu-email@exemplo.com>

LEMBRETE_ANTECEDENCIA_H=24
LEMBRETE_INTERVALO_MIN=10
